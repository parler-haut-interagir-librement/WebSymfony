{% extends 'base.html.twig' %}

{% block title %}{{ 'account.title'|trans }} | {{ brand }}{% endblock %}

{% block body %}
    <article>
        <header>
            <h2>{{ 'account.title'|trans }}</h2>
            <p>{{ 'account.welcome'|trans({'%username%': user.userIdentifier}) }}</p>
        </header>

        <table>
            <tr>
                <th scope="row">{{ 'account.username'|trans }}</th>
                <td>{{ user.username }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'account.email'|trans }}</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'account.roles'|trans }}</th>
                <td>{% for role in user.roles %}<kbd class="role">{{ role }}</kbd> {% endfor %}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'account.created_at'|trans }}</th>
                <td>{{ user.createdAt|date('Y-m-d H:i') }}</td>
            </tr>
        </table>
    </article>
{% endblock %}
